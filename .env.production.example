# Production deployment configuration for docker-compose.deploy.yml (Milestone 18).
#
#   cp .env.production.example .env.production   # then edit
#   docker compose --env-file .env.production -f docker-compose.deploy.yml up -d
#
# PLACEHOLDERS ONLY. Never commit a filled-in .env.production — it is git-ignored
# and .dockerignore'd. Real secrets come from your host's secret store / a file
# with 600 perms, never from version control.
# ---------------------------------------------------------------------------

# === Release selection ===
# Which published image tag to run. Defaults to "latest" if unset; pin a
# commit-derived tag (e.g. sha-1a2b3c4) or a version tag (e.g. v1.4.0) for a
# reproducible deployment. Images: ghcr.io/sumit-0610/ai-service-booking-platform-{api,migrator,web}
IMAGE_TAG=v0.0.0

# === REQUIRED — PostgreSQL (bundled service) ===
# Set a strong password. If you use the bundled `postgres` service, DATABASE_URL
# below must use this exact password.
POSTGRES_PASSWORD=replace-with-a-strong-password
# Optional overrides (defaults shown):
# POSTGRES_USER=app
# POSTGRES_DB=ai_service_booking_platform

# === REQUIRED — API configuration ===
# Connection string the API + migrator use. For the bundled DB, host is the
# compose service name `postgres` and the password must match POSTGRES_PASSWORD.
# For an external managed database, point this at that host instead.
DATABASE_URL=postgresql://app:replace-with-a-strong-password@postgres:5432/ai_service_booking_platform

# Redis connection string. For the bundled `redis` service this is the value
# below; for an external Redis, include credentials here.
REDIS_URL=redis://redis:6379

# The browser-facing origin of the web app (scheme + host + optional port), used
# for CORS and session-cookie scope. MUST be the real HTTPS origin in production;
# the API refuses to start in production if this is missing.
WEB_ORIGIN=https://app.example.com

# === OPTIONAL — Claude AI Booking Assistant ===
# Server-side only. With no key the assistant endpoints return 503 and the rest
# of the platform is unaffected. Leave unset/empty to disable.
# ANTHROPIC_API_KEY=sk-ant-...

# === OPTIONAL — host port binds (loopback only) ===
# The reverse proxy on the host forwards to these; they are never public.
# API_PORT=4000
# WEB_PORT=8080

# === NOT SET HERE (baked into the image at build time) ===
# NODE_ENV=production, COOKIE_SECURE=true, TRUST_PROXY=true are fixed by
# docker-compose.deploy.yml. APP_VERSION / APP_COMMIT / APP_BUILD_TIME are baked
# into the published image by the release workflow and reported at
# GET /api/v1/health — do not set them here.
