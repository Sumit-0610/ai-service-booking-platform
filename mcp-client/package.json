{
  "name": "@aisbp/mcp-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "aisbp-mcp-client": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx --conditions=development watch src/index.ts",
    "start": "node dist/index.js",
    "chat": "tsx --conditions=development src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run"
  },
  "dependencies": {
    "@aisbp/database": "workspace:*",
    "@aisbp/mcp-server": "workspace:*",
    "@aisbp/shared": "workspace:*",
    "@google/genai": "2.21.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "^17.2.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@aisbp/config": "workspace:*",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
