# Variables read by docker-compose.prod.yml. Copy to `.env` and edit as needed:
#   cp .env.example .env
# Everything here has a working local default — an empty `.env` runs the stack.
# A real deployment supplies these through its own secret store, never a file.

# --- PostgreSQL ---
# Local default only. Override with a strong value outside local development.
POSTGRES_PASSWORD=app_password

# --- host ports the browser uses ---
API_PORT=4000
WEB_PORT=8080

# --- API configuration ---
# The origin the SPA is served from — used for CORS and cookie scope.
WEB_ORIGIN=http://localhost:8080

# --- web build ---
# Baked into the JS bundle at image build time. Must be the URL the *browser*
# uses to reach the API (a host address), not a compose service name.
VITE_API_BASE_URL=http://localhost:4000

# --- Claude AI Booking Assistant (optional) ---
# Server-side only. With no key the assistant endpoints return 503 and the rest
# of the platform is unaffected.
# ANTHROPIC_API_KEY=sk-ant-...
