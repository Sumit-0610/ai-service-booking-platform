{
  "name": "ai-service-booking-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @aisbp/api --filter @aisbp/web --parallel dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "db:migrate:deploy": "pnpm --filter @aisbp/database db:migrate:deploy",
    "db:seed": "pnpm --filter @aisbp/database db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.41.0"
  }
}
