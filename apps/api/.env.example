# Local placeholders only. Do not commit a real .env.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://app:app_password@localhost:5432/ai_service_booking_platform
REDIS_URL=redis://localhost:6379

# Sessions and cookies (all optional — sane defaults shown)
# SESSION_COOKIE_NAME=aisbp.sid
# CSRF_COOKIE_NAME=aisbp.csrf
# SESSION_TTL_SECONDS=604800
# COOKIE_SECURE=false            # defaults to true when NODE_ENV=production
# TRUST_PROXY=false              # set true behind a load balancer

# Brute-force protection (optional)
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# REGISTER_RATE_LIMIT_MAX=5
# REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# Redis read-through cache — Milestone 13 (optional)
# CACHE_ENABLED=true                # set false to bypass the cache entirely
# CATALOGUE_CACHE_TTL_SECONDS=120   # public catalogue (categories + services)

# Claude AI Booking Assistant — Milestone 14
# ANTHROPIC_API_KEY is server-side only. With no key the assistant endpoints
# return 503 and the rest of the API is unaffected.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# AI_ASSISTANT_ENABLED=true
# AI_REQUEST_TIMEOUT_MS=15000
# AI_MAX_MESSAGE_CHARS=2000
# AI_RATE_LIMIT_MAX=20
# AI_RATE_LIMIT_WINDOW_SECONDS=3600
