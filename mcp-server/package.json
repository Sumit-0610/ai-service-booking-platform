{
  "name": "@aisbp/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "aisbp-mcp-server": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./src/server.ts",
      "development": "./src/server.ts",
      "default": "./dist/server.js"
    },
    "./context": {
      "types": "./src/context.ts",
      "development": "./src/context.ts",
      "default": "./dist/context.js"
    },
    "./http": {
      "types": "./src/http.ts",
      "development": "./src/http.ts",
      "default": "./dist/http.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx --conditions=development watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run",
    "smoke": "tsx --conditions=development scripts/smoke.ts"
  },
  "dependencies": {
    "@aisbp/database": "workspace:*",
    "@aisbp/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "^17.2.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@aisbp/config": "workspace:*",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
